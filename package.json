{
  "name": "@ziran-project/q",
  "version": "0.1.0",
  "description": "Hold Q, point at a destination, and let go. A radial navigation wheel for keyboard and pointer, in TypeScript.",
  "keywords": [
    "accessible",
    "design-system",
    "headless",
    "hotkeys",
    "keyboard",
    "navbar",
    "navigation",
    "radial-menu",
    "radial-navigation",
    "typescript"
  ],
  "homepage": "https://ulloasp.github.io/q/",
  "bugs": {
    "url": "https://github.com/UlloaSP/q/issues"
  },
  "license": "MIT",
  "author": "Pablo Ulloa Santín",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/UlloaSP/q.git"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./headless": {
      "types": "./dist/headless.d.ts",
      "import": "./dist/headless.js",
      "default": "./dist/headless.js"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "dev": "vp dev",
    "build": "vp pack",
    "build:site": "vp build",
    "test": "vp test",
    "check": "vp check && vp test && vp pack",
    "prepack": "vp pack"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "jsdom": "^30.1.1",
    "typescript": "^7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.0.0",
    "vite-plus": "1.0.0"
  },
  "overrides": {
    "vite": "$vite",
    "vitest": "5.0.1"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
